+test('unconfigured and unsupported do not register worker or request permission',async()=>{const f=fixture();assert.equal(await createPushClient({api:f.api,publicKey:'',env:f.env}).status(),'unconfigured');f.env.isSecureContext=false;assert.equal(await f.client.status(),'unsupported');assert.deepEqual(f.calls,[]);});
