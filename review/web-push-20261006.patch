diff --git a/supabase/functions/push-worker/index.ts b/supabase/functions/push-worker/index.ts
new file mode 100644
index 0000000..6506c77
--- /dev/null
+++ b/supabase/functions/push-worker/index.ts
@@ -0,0 +1,13 @@
+import webpush from 'web-push';
+import {processPushBatch} from './worker.js';
+// Server-only scheduled endpoint. No user-supplied recipient or payload.
+Deno.serve(async request=>{
+ const secret=Deno.env.get('PUSH_WORKER_SECRET');
+ if(request.method!=='POST'||!secret||request.headers.get('x-push-secret')!==secret)return new Response('Unauthorized',{status:401});
+ const base=Deno.env.get('SUPABASE_URL'),key=Deno.env.get('SUPABASE_SERVICE_ROLE_KEY');
+ const publicKey=Deno.env.get('VAPID_PUBLIC_KEY'),privateKey=Deno.env.get('VAPID_PRIVATE_KEY'),subject=Deno.env.get('VAPID_SUBJECT');
+ if(!base||!key||!publicKey||!privateKey||!subject)return new Response('Not configured',{status:503});
+ const rpc=async(name:string,body:unknown)=>{const response=await fetch(`${base}/rest/v1/rpc/${name}`,{method:'POST',headers:{apikey:key,Authorization:`Bearer ${key}`,'Content-Type':'application/json'},body:JSON.stringify(body),signal:AbortSignal.timeout(10000)});if(!response.ok)throw Error('Push queue failed');return response.status===204?null:response.json();};
+ try{const result=await processPushBatch({rpc,send:(subscription:unknown,payload:string)=>webpush.sendNotification(subscription,payload,{vapidDetails:{subject,publicKey,privateKey},TTL:3600,timeout:10000})});return Response.json(result);}
+ catch{return new Response('Push processing failed',{status:503});}
+});
diff --git a/supabase/functions/push-worker/worker.js b/supabase/functions/push-worker/worker.js
new file mode 100644
index 0000000..98e3393
--- /dev/null
+++ b/supabase/functions/push-worker/worker.js
@@ -0,0 +1,12 @@
+const endpointPattern=/^https:\/\/(web\.push\.apple\.com|fcm\.googleapis\.com|updates\.push\.services\.mozilla\.com|[a-z0-9-]+\.notify\.windows\.com)\/[^#\s]+$/;
+export async function processPushBatch({rpc,send}){
+ const jobs=await rpc('claim_push',{});const counts={sent:0,gone:0,retry:0,failed:0};
+ for(const job of jobs){let result='failed';if(job.endpoint.length<=4096&&endpointPattern.test(job.endpoint)){
+  try{await send({endpoint:job.endpoint,keys:job.keys},JSON.stringify({id:job.id,po_id:job.po_id,subscription_id:job.subscription_id}));result='sent';}
+  catch(error){const status=Number(error?.statusCode);result=status===404||status===410?'gone':!status||status===429||status>=500?'retry':'failed';}
+ }
+ await rpc('finish_push',{p_id:job.delivery_id,p_lease:job.lease_id,p_result:result});
+ counts[result]++;
+ }
+ return {processed:jobs.length,...counts};
+}
diff --git a/supabase/migrations/20261006071609_web_push_notifications.sql b/supabase/migrations/20261006071609_web_push_notifications.sql
new file mode 100644
index 0000000..6e36a24
--- /dev/null
+++ b/supabase/migrations/20261006071609_web_push_notifications.sql
@@ -0,0 +1,93 @@
+-- Unreleased. Created with Supabase CLI; never applied to production during development.
+begin;
+create table public.push_subscriptions (
+ id uuid primary key default gen_random_uuid(),
+ user_id uuid not null references public.profiles(id),
+ endpoint text not null unique,
+ p256dh text not null,
+ auth text not null,
+ created_at timestamptz not null default now(),
+ updated_at timestamptz not null default now(),
+ constraint valid_push_endpoint check(length(endpoint)<=4096 and endpoint ~ '^https://(web\.push\.apple\.com|fcm\.googleapis\.com|updates\.push\.services\.mozilla\.com|[a-z0-9-]+\.notify\.windows\.com)/[^#[:space:]]+$'),
+ constraint valid_push_keys check(p256dh ~ '^[A-Za-z0-9_-]{87}=?$' and auth ~ '^[A-Za-z0-9_-]{22}={0,2}$')
+);
+create index push_subscriptions_user on public.push_subscriptions(user_id);
+create table public.push_deliveries (
+ id uuid primary key default gen_random_uuid(),
+ notification_id uuid not null references public.notifications(id) on delete cascade,
+ subscription_id uuid not null references public.push_subscriptions(id) on delete cascade,
+ attempts integer not null default 0,
+ available_at timestamptz not null default now(),
+ lease_id uuid,
+ leased_until timestamptz,
+ created_at timestamptz not null default now(),
+ unique(notification_id,subscription_id)
+);
+create index push_deliveries_due on public.push_deliveries(available_at);
+alter table public.push_subscriptions enable row level security;
+alter table public.push_deliveries enable row level security;
+revoke all on public.push_subscriptions,public.push_deliveries from public,anon,authenticated;
+grant all on public.push_subscriptions,public.push_deliveries to service_role;
+
+create function public.register_push(p_endpoint text,p_p256dh text,p_auth text) returns uuid language plpgsql security definer set search_path='' as $$
+declare v_user uuid:=auth.uid(); v_id uuid; v_existing public.push_subscriptions;
+begin
+ if v_user is null or not exists(select 1 from public.profiles where id=v_user and deleted_at is null) then raise exception 'บัญชีนี้ไม่มีสิทธิ์ใช้งาน'; end if;
+ perform pg_catalog.pg_advisory_xact_lock(pg_catalog.hashtextextended(v_user::text,0));
+ if not exists(select 1 from public.push_subscriptions where endpoint=p_endpoint) and (select count(*) from public.push_subscriptions where user_id=v_user)>=20 then raise exception 'เปิดแจ้งเตือนได้ไม่เกิน 20 เครื่องต่อบัญชี'; end if;
+ select * into v_existing from public.push_subscriptions where endpoint=p_endpoint for update;
+ if found and v_existing.user_id<>v_user then raise exception 'กรุณาปิดแจ้งเตือนของบัญชีเดิมก่อนเปลี่ยนบัญชี'; end if;
+ insert into public.push_subscriptions(user_id,endpoint,p256dh,auth) values(v_user,p_endpoint,p_p256dh,p_auth)
+ on conflict(endpoint) do update set p256dh=excluded.p256dh,auth=excluded.auth,updated_at=now()
+ where push_subscriptions.user_id=v_user returning id into v_id;
+ if v_id is null then raise exception 'กรุณาปิดแจ้งเตือนของบัญชีเดิมก่อนเปลี่ยนบัญชี'; end if;
+ return v_id;
+end $$;
+create function public.unregister_push(p_endpoint text) returns void language sql security definer set search_path='' as $$
+ delete from public.push_subscriptions where endpoint=p_endpoint and user_id=auth.uid();
+$$;
+revoke all on function public.register_push(text,text,text),public.unregister_push(text) from public,anon,authenticated;
+grant execute on function public.register_push(text,text,text),public.unregister_push(text) to authenticated;
+
+create schema if not exists po_push_private;
+revoke all on schema po_push_private from public,anon,authenticated;
+create function po_push_private.enqueue() returns trigger language plpgsql security definer set search_path='' as $$
+begin
+ insert into public.push_deliveries(notification_id,subscription_id)
+ select new.id,s.id from public.push_subscriptions s join public.profiles p on p.id=s.user_id
+ where s.user_id=new.recipient_id and p.deleted_at is null on conflict do nothing;
+ return new;
+end $$;
+revoke all on function po_push_private.enqueue() from public,anon,authenticated;
+create trigger notification_push after insert on public.notifications for each row execute function po_push_private.enqueue();
+
+create function public.claim_push() returns jsonb language plpgsql security definer set search_path='' as $$
+declare v_lease uuid:=gen_random_uuid(); v_result jsonb;
+begin
+ -- Bounded retention, including dead letters; business notifications are untouched.
+ delete from public.push_deliveries where created_at<now()-interval '1 day' or attempts>=5;
+ delete from public.push_subscriptions s where not exists(select 1 from public.profiles p where p.id=s.user_id and p.deleted_at is null);
+ with due as (
+ select d.id from public.push_deliveries d where d.available_at<=now() and (d.leased_until is null or d.leased_until<now())
+ order by d.available_at limit 5 for update skip locked
+ ), claimed as (
+ update public.push_deliveries d set lease_id=v_lease,leased_until=now()+interval '2 minutes',attempts=d.attempts+1
+ from due where d.id=due.id returning d.*
+ ) select coalesce(jsonb_agg(jsonb_build_object('delivery_id',d.id,'lease_id',v_lease,'attempts',d.attempts,'id',n.id,'po_id',n.po_id,'subscription_id',s.id,'endpoint',s.endpoint,'keys',jsonb_build_object('p256dh',s.p256dh,'auth',s.auth))),'[]'::jsonb)
+ into v_result from claimed d join public.notifications n on n.id=d.notification_id join public.push_subscriptions s on s.id=d.subscription_id and s.user_id=n.recipient_id;
+ return v_result;
+end $$;
+create function public.finish_push(p_id uuid,p_lease uuid,p_result text) returns void language plpgsql security definer set search_path='' as $$
+declare v_sub uuid;
+begin
+ if p_result not in ('sent','gone','retry','failed') then raise exception 'Invalid result'; end if;
+ select subscription_id into v_sub from public.push_deliveries where id=p_id and lease_id=p_lease;
+ if not found then return; end if;
+ if p_result='gone' then delete from public.push_subscriptions where id=v_sub;
+ elsif p_result in ('sent','failed') then delete from public.push_deliveries where id=p_id and lease_id=p_lease;
+ else update public.push_deliveries set lease_id=null,leased_until=null,available_at=now()+make_interval(secs=>least(3600,60*(2^attempts)::integer)) where id=p_id and lease_id=p_lease;
+ end if;
+end $$;
+revoke all on function public.claim_push(),public.finish_push(uuid,uuid,text) from public,anon,authenticated;
+grant execute on function public.claim_push(),public.finish_push(uuid,uuid,text) to service_role;
+commit;
