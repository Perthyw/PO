diff --git a/dist/push.js b/dist/push.js
new file mode 100644
index 0000000..d44dd34
--- /dev/null
+++ b/dist/push.js
@@ -0,0 +1,12 @@
+// Permission is requested only by the explicit Enable button.
+export function createPushClient({api,publicKey,env=globalThis}){
+ const supported=()=>Boolean(env.isSecureContext&&env.navigator?.serviceWorker&&env.PushManager&&env.Notification);
+ let registration,generation=0;
+ async function worker(){registration ||= await env.navigator.serviceWorker.register('/sw.js',{scope:'/'});return env.navigator.serviceWorker.ready;}
+ async function binding(reg,id){const target=reg.active||reg.waiting||reg.installing;if(!target)throw Error('ระบบแจ้งเตือนยังเริ่มไม่เสร็จ กรุณาลองอีกครั้ง');await new Promise((resolve,reject)=>{const channel=new env.MessageChannel();const timer=env.setTimeout(()=>reject(Error('บันทึกการแจ้งเตือนไม่สำเร็จ กรุณาลองอีกครั้ง')),5000);channel.port1.onmessage=e=>{env.clearTimeout(timer);channel.port1.close();e.data?.ok?resolve():reject(Error('บันทึกการแจ้งเตือนไม่สำเร็จ'));};target.postMessage({type:'push-binding',id},[channel.port2]);});}
+ async function status(){if(!supported())return 'unsupported';if(!publicKey)return 'unconfigured';if(env.Notification.permission==='denied')return 'denied';const reg=await worker();if(await reg.pushManager.getSubscription()){await sync();return 'enabled';}return 'off';}
+ async function enable(){if(!supported())throw Error('เครื่องนี้ยังเปิดแจ้งเตือนไม่ได้ บน iPhone ให้เปิดจากไอคอน PO บนหน้าจอโฮม');if(!publicKey)throw Error('ระบบแจ้งเตือนยังไม่เปิดใช้งาน');const permission=await env.Notification.requestPermission();if(permission!=='granted')throw Error('ยังไม่ได้อนุญาตแจ้งเตือน กรุณาตรวจสิทธิ์ของเว็บในการตั้งค่าเครื่อง');const reg=await worker();let sub=await reg.pushManager.getSubscription();if(!sub){const raw=publicKey.replace(/-/g,'+').replace(/_/g,'/');const key=Uint8Array.from(env.atob(raw),c=>c.charCodeAt(0));sub=await reg.pushManager.subscribe({userVisibleOnly:true,applicationServerKey:key});}try{const id=await api.registerPush(sub.toJSON());await binding(reg,id);return id;}catch(e){await binding(reg,null);await sub.unsubscribe();throw e;}}
+ async function sync(){const started=generation;if(supported()&&publicKey&&env.Notification.permission==='granted'){const reg=await worker();const sub=await reg.pushManager.getSubscription();if(sub){await binding(reg,null);const id=await api.registerPush(sub.toJSON());if(started===generation)await binding(reg,id);}}}
+ async function disable(){generation++;if(!supported()||!publicKey)return;const reg=await worker();await binding(reg,null);const sub=await reg.pushManager.getSubscription();if(sub){const endpoint=sub.endpoint;if(!await sub.unsubscribe())throw Error('ปิดแจ้งเตือนไม่สำเร็จ กรุณาลองอีกครั้ง');await api.unregisterPush(endpoint);}}
+ return {status,enable,sync,disable};
+}
diff --git a/dist/sw.js b/dist/sw.js
new file mode 100644
index 0000000..03c5ff1
--- /dev/null
+++ b/dist/sw.js
@@ -0,0 +1,10 @@
+// No caches: never persist PO data or authenticated responses.
+function database(){return new Promise((resolve,reject)=>{const request=indexedDB.open('po-push-binding',1);request.onupgradeneeded=()=>request.result.createObjectStore('settings');request.onsuccess=()=>resolve(request.result);request.onerror=()=>reject(request.error);});}
+async function writeBinding(id){const db=await database();try{await new Promise((resolve,reject)=>{const tx=db.transaction('settings','readwrite');tx.objectStore('settings').put(id,'id');tx.oncomplete=resolve;tx.onerror=()=>reject(tx.error);});}finally{db.close();}}
+async function readBinding(){const db=await database();try{return await new Promise((resolve,reject)=>{const request=db.transaction('settings').objectStore('settings').get('id');request.onsuccess=()=>resolve(request.result);request.onerror=()=>reject(request.error);});}finally{db.close();}}
+self.addEventListener('install',event=>event.waitUntil(self.skipWaiting()));
+self.addEventListener('activate',event=>event.waitUntil(self.clients.claim()));
+self.addEventListener('message',event=>{if(event.data?.type!=='push-binding')return;event.waitUntil(writeBinding(event.data.id||null).then(()=>event.ports[0]?.postMessage({ok:true}),()=>event.ports[0]?.postMessage({ok:false})));});
+self.addEventListener('push',event=>event.waitUntil((async()=>{let data;try{data=event.data.json();}catch{return;}const binding=await readBinding();if(!binding||binding!==data.subscription_id||!validId(data.po_id)||!validId(data.id))return;await self.registration.showNotification('PO The Grands',{body:'มีการอัปเดตใบ PO แตะเพื่อดูรายละเอียด',tag:'po-'+data.id,icon:'/push-icon-192.png',badge:'/push-icon-192.png',data:{po_id:data.po_id}});})()));
+function validId(value){return typeof value==='string'&&/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(value);}
+self.addEventListener('notificationclick',event=>{event.notification.close();event.waitUntil((async()=>{const id=event.notification.data?.po_id;if(!validId(id))return;const url=new URL('/?po='+encodeURIComponent(id),self.location.origin).href;const clients=await self.clients.matchAll({type:'window',includeUncontrolled:true});const client=clients.find(c=>new URL(c.url).origin===self.location.origin);if(client){await client.navigate(url);await client.focus();}else await self.clients.openWindow(url);})());});
